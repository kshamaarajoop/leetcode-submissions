class Solution:
    def containsNearbyDuplicate(self, nums: List[int], k: int) -> bool:
        #hashmap + sliding window, sliding window = k
        hmap = {}

        for i in range(len(nums)):
            if nums[i] in hmap:
                return True
            hmap[nums[i]] = i
            if len(hmap) > k:
                hmap.pop(nums[i-k])
        return False
        
