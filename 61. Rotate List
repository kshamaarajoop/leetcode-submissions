# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def rotateRight(self, head: ListNode | None, k: int) -> ListNode | None:
        if not head:
            return head
        length = 1
        dummy = head
        while dummy.next:
            dummy = dummy.next
            length += 1
        pos = k % length
        if pos == 0:
            return head
        current = head
        for i in range(length-pos-1):
            current = current.next
        
        new_head = current.next
        #breaking off the list
        current.next = None
        dummy.next = head
        return new_head
