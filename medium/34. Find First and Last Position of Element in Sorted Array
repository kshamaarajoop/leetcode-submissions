class Solution:
    def searchRange(self, nums: list[int], target: int) -> list[int]:
        if not nums:
            return [-1,-1]
        
        res = []
        l,r=0,len(nums)-1
        first = -1
        while l<=r:
            mid = (l+r)//2
            if nums[mid] == target:
                first = mid
                r = mid -1 #search left
            elif nums[mid]<target:
                l = mid + 1
            else:
                r = mid - 1

        last = -1
        l,r=0,len(nums)-1
        while l<=r:
            mid = (l+r)//2
            if nums[mid] == target:
                last = mid
                l = mid + 1 #search right
            elif nums[mid]<target:
                l = mid + 1
            else:
                r = mid - 1
        return [first,last]
