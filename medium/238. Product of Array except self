class Solution:
    def productExceptSelf(self, nums: List[int]) -> List[int]:
        ans = [1]*len(nums)
        pre=1
        post = 1
        for i in range(len(nums)):
            if i == 0:
                ans[i] = pre
            else:
                ans[i] = pre*nums[i-1]
                pre = ans[i]
        for i in range(len(nums)-1,-1,-1):
            ans[i] *= post 
            post *= nums[i]
            print(i)
        #post fix
        #for i in range()

        print(ans)
        return ans
            
            

        
