class Solution:
    def checkInclusion(self, s1: str, s2: str) -> bool:
        hMap = {}

        for i, val in enumerate(s1):
            hMap[val] = hMap.get(val, 0) + 1
        print(hMap)
        winMap = {}

        l = 0
        matches = 0
        for r in range(len(s2)):
            char = s2[r]
            winMap[char] =  winMap.get(char , 0) + 1

            if char in hMap and winMap[char] == hMap[char]:
                matches += 1
            
            if (r-l+1)>len(s1):
                ch = s2[l]
                if ch in hMap and winMap[ch] == hMap[ch]:
                    matches -= 1
                winMap[ch] -= 1
                if winMap[ch]==0:
                    winMap.pop(ch)
                l += 1

            if len(s1)==(r-l+1):
                if matches == len(hMap):
                    return True
        return False
            
